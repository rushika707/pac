{
  "policies": [
    {
      "policy_metadata": {
        "policy_id": "AI-DP-PII-001",
        "policy_name": "AI Training Data PII Policy",
        "version": "1.0",
        "classification": "Internal",
        "policy_owner": "Data Protection Office",
        "applies_to": "Training, testing, fine-tuning and evaluation datasets used for AI, ML and analytics",
        "review_cycle": "Annual or upon material change to privacy, AI or data governance requirements"
      },
      "purpose": "This policy defines mandatory requirements for identifying, flagging and remediating personal data in datasets used for artificial intelligence, machine learning, model fine-tuning, model evaluation and analytics activities.",
      "scope": "This policy applies to all datasets that are proposed for AI or machine learning use, including raw data, curated training data, labelled data, test data, validation data, embeddings, logs, prompts, responses and synthetic data derived from personal data.",
      "definitions": [
        {
          "term": "Personal data / PII",
          "definition": "Information that identifies, or can reasonably identify, a living individual either directly or in combination with other information."
        },
        {
          "term": "Direct identifier",
          "definition": "A data item that can identify an individual on its own."
        },
        {
          "term": "Indirect identifier",
          "definition": "A data item that may identify an individual when combined with other information."
        },
        {
          "term": "Sensitive personal data",
          "definition": "More sensitive information such as health, ethnicity, religion, political opinion, biometric or genetic information."
        },
        {
          "term": "Training data",
          "definition": "Any dataset used to train, fine-tune, evaluate or improve an AI, ML or analytics model."
        },
        {
          "term": "Flagged record",
          "definition": "A dataset record where one or more policy rules identify personal data or suspected personal data."
        },
        {
          "term": "Remediation",
          "definition": "Action taken to remove, mask, tokenise, generalise or anonymise personal data before dataset use."
        }
      ],
      "rules": [
