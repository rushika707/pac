{
  "policies": [
    {
      "policy_metadata": {
        "policy_id": "AI-DP-PII-001",
        "policy_name": "AI Training Data PII Policy",
        "version": "1.0",
        "classification": "Internal",
        "policy_owner": "Data Protection Office",
        "applies_to": "Training, testing, fine-tuning and evaluation datasets used for AI, ML and analytics",
        "review_cycle": "Annual or upon material change to privacy, AI or data governance requirements"
      },
      "purpose": "This policy defines mandatory requirements for identifying, flagging and remediating personal data in datasets used for artificial intelligence, machine learning, model fine-tuning, model evaluation and analytics activities.",
      "scope": "This policy applies to all datasets that are proposed for AI or machine learning use, including raw data, curated training data, labelled data, test data, validation data, embeddings, logs, prompts, responses and synthetic data derived from personal data.",
      "definitions": [
        {
          "term": "Personal data / PII",
          "definition": "Information that identifies, or can reasonably identify, a living individual either directly or in combination with other information."
        },
        {
          "term": "Direct identifier",
          "definition": "A data item that can identify an individual on its own."
        },
        {
          "term": "Indirect identifier",
          "definition": "A data item that may identify an individual when combined with other information."
        },
        {
          "term": "Sensitive personal data",
          "definition": "More sensitive information such as health, ethnicity, religion, political opinion, biometric or genetic information."
        },
        {
          "term": "Training data",
          "definition": "Any dataset used to train, fine-tune, evaluate or improve an AI, ML or analytics model."
        },
        {
          "term": "Flagged record",
          "definition": "A dataset record where one or more policy rules identify personal data or suspected personal data."
        },
        {
          "term": "Remediation",
          "definition": "Action taken to remove, mask, tokenise, generalise or anonymise personal data before dataset use."
        }
      ],
      "rules": [
        {
          "rule_id": "PII-01",
          "description": "Full name",
          "execution": {
            "type": "field",
            "fields": [
              [
                "first_name",
                "last_name"
              ],
              [
                "full_name",
                "customer_name"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "PII-02",
          "description": "Personal email address",
          "execution": {
            "type": "field",
            "fields": [
              [
                "email",
                "personal_email"
              ],
              [
                "contact_email"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "PII-03",
          "description": "Phone or mobile number",
          "execution": {
            "type": "field",
            "fields": [
              [
                "mobile",
                "telephone"
              ],
              [
                "phone_number"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "PII-04",
          "description": "Postal or home address",
          "execution": {
            "type": "field",
            "fields": [
              [
                "address",
                "home_address"
              ],
              [
                "street",
                "postcode with address"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "PII-05",
          "description": "National Insurance number",
          "execution": {
            "type": "field",
            "fields": [
              [
                "ni_number",
                "nino"
              ]
            ]
          },
          "outcome": "Block until removed or approved"
        },
        {
          "rule_id": "PII-06",
          "description": "Passport number",
          "execution": {
            "type": "field",
            "fields": [
              [
                "passport_number"
              ]
            ]
          },
          "outcome": "Block until removed or approved"
        },
        {
          "rule_id": "PII-07",
          "description": "Driving licence number",
          "execution": {
            "type": "field",
            "fields": [
              [
                "driving_licence_number"
              ]
            ]
          },
          "outcome": "Block until removed or approved"
        },
        {
          "rule_id": "PII-08",
          "description": "Bank account or payment card number",
          "execution": {
            "type": "field",
            "fields": [
              [
                "bank_account",
                "sort_code"
              ],
              [
                "credit_card_number"
              ]
            ]
          },
          "outcome": "Block until removed or approved"
        },
        {
          "rule_id": "PII-09",
          "description": "Online identifier",
          "execution": {
            "type": "field",
            "fields": [
              [
                "IP address",
                "device ID"
              ],
              [
                "cookie ID",
                "user ID where linkable to a person"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "SPII-01",
          "description": "Health or medical information",
          "execution": {
            "type": "field",
            "fields": [
              [
                "medical_condition",
                "diagnosis"
              ],
              [
                "treatment",
                "disability information"
              ]
            ]
          },
          "outcome": "Block record"
        },
        {
          "rule_id": "SPII-02",
          "description": "Ethnicity or racial origin",
          "execution": {
            "type": "field",
            "fields": [
              [
                "ethnicity",
                "race"
              ],
              [
                "racial_origin"
              ]
            ]
          },
          "outcome": "Block record"
        },
        {
          "rule_id": "SPII-03",
          "description": "Religion or belief",
          "execution": {
            "type": "field",
            "fields": [
              [
                "religion",
                "belief"
              ]
            ]
          },
          "outcome": "Block record"
        },
        {
          "rule_id": "SPII-04",
          "description": "Political opinion",
          "execution": {
            "type": "field",
            "fields": [
              [
                "political_view",
                "party_preference"
              ]
            ]
          },
          "outcome": "Block record"
        },
        {
          "rule_id": "SPII-05",
          "description": "Trade union membership",
          "execution": {
            "type": "field",
            "fields": [
              [
                "union_member",
                "trade_union"
              ]
            ]
          },
          "outcome": "Block record"
        },
        {
          "rule_id": "SPII-06",
          "description": "Biometric or genetic data",
          "execution": {
            "type": "field",
            "fields": [
              [
                "faceprint",
                "fingerprint"
              ],
              [
                "iris_scan",
                "DNA profile"
              ]
            ]
          },
          "outcome": "Block record"
        },
        {
          "rule_id": "CPII-01",
          "description": "Full name + date of birth",
          "execution": {
            "type": "combination",
            "fields": [
              [
                "full name",
                "date of birth"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "CPII-02",
          "description": "Full name + postal address or postcode",
          "execution": {
            "type": "combination",
            "fields": [
              [
                "full name",
                "postal address"
              ],
              [
                "full name",
                "postcode"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "CPII-03",
          "description": "Full name + phone number",
          "execution": {
            "type": "combination",
            "fields": [
              [
                "full name",
                "phone number"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "CPII-04",
          "description": "Full name + personal email address",
          "execution": {
            "type": "combination",
            "fields": [
              [
                "full name",
                "personal email address"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "CPII-05",
          "description": "Date of birth + postcode + gender",
          "execution": {
            "type": "combination",
            "fields": [
              [
                "date of birth",
                "postcode",
                "gender"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "CPII-06",
          "description": "Employee ID + department + role where linkable to a person",
          "execution": {
            "type": "combination",
            "fields": [
              [
                "Employee ID",
                "department"
              ],
              [
                "role where linkable to a person"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "CPII-07",
          "description": "Customer ID + account event details where the customer can be re-identified",
          "execution": {
            "type": "combination",
            "fields": [
              [
                "Customer ID",
                "account event details"
              ]
            ]
          },
          "outcome": "Flag record"
        },
        {
          "rule_id": "CPII-08",
          "description": "Free-text comments containing personal identifiers",
          "execution": {
            "type": "text",
            "fields": [
              [
                "free-text comments"
              ]
            ],
            "patterns": [
              "personal identifiers"
            ]
          },
          "outcome": "Flag record"
        }
      ],
      "requirements": [
        {
          "rule_id": "DP-01",
          "description": "Pre-use scan",
          "execution": {
            "type": "manual",
            "reason": "Training data must be scanned for personal data before it is used for model training, fine-tuning, testing or evaluation."
          }
        },
        {
          "rule_id": "DP-02",
          "description": "Record-level flagging",
          "execution": {
            "type": "manual",
            "reason": "Each record containing direct, sensitive or combination-based personal data must be flagged."
          }
        },
        {
          "rule_id": "DP-03",
          "description": "Direct identifier handling",
          "execution": {
            "type": "manual",
            "reason": "Direct identifiers must be removed, masked, tokenised or replaced before the record is approved for training use."
          }
        },
        {
          "rule_id": "DP-04",
          "description": "Sensitive data handling",
          "execution": {
            "type": "manual",
            "reason": "Sensitive personal data must be blocked from training data unless a documented approval and control justification exists."
          }
        },
        {
          "rule_id": "DP-05",
          "description": "Combination rule handling",
          "execution": {
            "type": "manual",
            "reason": "Records matching combination rules must be reviewed and remediated before use."
          }
        },
        {
          "rule_id": "DP-06",
          "description": "Free-text scanning",
          "execution": {
            "type": "manual",
            "reason": "Free-text fields such as comments, notes, feedback and descriptions must be scanned for personal data patterns."
          }
        },
        {
          "rule_id": "DP-07",
          "description": "Remediation evidence",
          "execution": {
            "type": "manual",
            "reason": "Every remediated record must retain evidence of the remediation method applied."
          }
        },
        {
          "rule_id": "DP-08",
          "description": "Approved dataset output",
          "execution": {
            "type": "manual",
            "reason": "Only records with no unresolved personal data findings may be included in the approved training dataset."
          }
        },
        {
          "rule_id": "DP-09",
          "description": "Exception handling",
          "execution": {
            "type": "manual",
            "reason": "Exceptions must be documented, risk-assessed, time-bound and approved by the Data Protection Office or delegated authority."
          }
        },
        {
          "rule_id": "DP-10",
          "description": "Audit trail",
          "execution": {
            "type": "manual",
            "reason": "The scan result, triggered rule, decision, remediation status and approver must be retained for audit purposes."
          },
          "decisions": [
            {
              "decision": "PASS",
              "meaning": "No personal data or suspected personal, data has been detected.",
              "required_action": "Record may be included in the approved training dataset."
            },
            {
              "decision": "FLAG",
              "meaning": "Direct or combination-based personal data has been detected.",
              "required_action": "Record must be remediated before training use."
            },
            {
              "decision": "BLOCK",
              "meaning": "Sensitive personal data or high-risk identifier has been detected.",
              "required_action": "Record must be excluded unless approved exception exists."
            },
            {
              "decision": "EXCEPTION APPROVED",
              "meaning": "A documented approval allows controlled use of the record.",
              "required_action": "Use only under the approved conditions and retain audit evidence."
            }
          ],
          "remediation": [
            {
              "remediation_method": "Removal",
              "policy_expectation": "Delete the personal data field or remove the record where the field is not required."
            },
            {
              "remediation_method": "Masking",
              "policy_expectation": "Replace part of the value while preserving limited analytical utility, where appropriate."
            },
            {
              "remediation_method": "Tokenisation",
              "policy_expectation": "Replace the identifier with a non-identifying token."
            },
            {
              "remediation_method": "Generalisation",
              "policy_expectation": "Reduce precision, such as replacing exact date of birth with age band."
            },
            {
              "remediation_method": "Anonymisation",
              "policy_expectation": "Transform data so individuals are no longer reasonably identifiable."
            }
          ],
          "evidence": [
            {
              "evidence_item": "Dataset name",
              "requirement": "Name and version of the dataset assessed."
            },
            {
              "evidence_item": "Scan date",
              "requirement": "Date when the dataset was scanned."
            },
            {
              "evidence_item": "Triggered rule IDs",
              "requirement": "List of policy rules triggered by each flagged record."
            },
            {
              "evidence_item": "Decision",
              "requirement": "PASS, FLAG, BLOCK or EXCEPTION APPROVED."
            },
            {
              "evidence_item": "Remediation status",
              "requirement": "Not required, pending, completed or exception approved."
            },
            {
              "evidence_item": "Reviewer or approver",
              "requirement": "Named reviewer or approval reference where required."
            }
          ]
        }
      ]
    }
  ]
}