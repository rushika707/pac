      "requirements": [
        {
          "requirement": "Pre-use data scan"
        },
        {
          "requirement": "Record-level flagging"
        },
        {
          "requirement": "Identifier handling"
        },
        {
          "requirement": "Restricted data handling"
        },
        {
          "requirement": "Combination handling"
        },
        {
          "requirement": "Free-text scanning"
        },
        {
          "requirement": "Purpose limitation"
        },
        {
          "requirement": "Approved dataset output"
        },
        {
          "requirement": "Exception handling"
        },
        {
          "requirement": "Audit trail"
        }
      ],
      "decisions": [
        {
          "decision": "PASS",
          "meaning": "No restricted or suspected customer data has been detected.",
          "action": "Record may be included in the approved analytics dataset."
        },
        {
          "decision": "FLAG",
          "meaning": "Direct or combination-based customer-identifying data has been detected.",
          "action": "Record must be remediated before general analytics or AI use."
        },
        {
          "decision": "BLOCK",
          "meaning": "Restricted data or a high-risk identifier has been detected.",
          "action": "Record must be excluded unless an approved exception exists."
        },
        {
          "decision": "EXCEPTION APPROVED",
          "meaning": "Documented approval permits controlled use of the record.",
          "action": "Use only under the approved conditions and retain audit evidence."
        }
      ],
      "remediation": [
        {
          "remediation": "Removal",
          "expectation": "Delete the customer data field or remove the record where the information is not required."
        },
        {
          "remediation": "Masking",
          "expectation": "Replace part of the value while preserving limited analytical utility, where appropriate."
        },
        {
          "remed,iation": "Tokenisation",
          "expectation": "Replace a customer identifier with a non-identifying token."
        },
        {
          "remediation": "Generalisation",
          "expectation": "Reduce precision, such as replacing exact location with region or age with an age band."
        },
        {
          "remediation": "Aggregation",
          "expectation": "Combine records or values so individual customers cannot reasonably be inferred."
        },
        {
          "remediation": "Anonymisation",
          "expectation": "Transform data so customers are no longer reasonably identifiable."
        }
      ],
      "evidence": [
        {
          "evidence": "Dataset name",
          "requirement": "Name and version of the dataset assessed."
        },
        {
          "evidence": "Scan date",
          "requirement": "Date when the dataset was scanned."
        },
        {
          "evidence": "Triggered rule IDs",
          "requirement": "List of policy rules triggered by each flagged or blocked record."
        },
        {
          "evidence": "Decision",
          "requirement": "PASS, FLAG, BLOCK or EXCEPTION APPROVED."
        },
        {
          "evidence": "Remediation status",
          "requirement": "Not required, pending, completed or exception approved."
        },
        {
          "evidence": "Purpose / use case",
          "requirement": "Approved analytics or AI purpose for which the dataset is being used."
        },
        {
          "evidence": "Reviewer or approver",
          "requirement": "Named reviewer or approval reference where required."
        }
      ]
